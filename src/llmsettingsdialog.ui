         <item row="1" column="1">
          <widget class="QLineEdit" name="editModelAnthropic">
           <property name="text"><string>claude-3-5-sonnet-20241022</string></property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout">
         <item>
          <widget class="QPushButton" name="btnConnectAnthropic">
           <property name="text"><string>Connect</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnDisconnectAnthropic">
           <property name="text"><string>Disconnect</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="labelStatusAnthropic">
           <property name="text"><string>Not connected</string></property>
          </widget>
         </item>
         <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
        </layout>
       </item>
       <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
      </layout>
     </widget>

     <!-- Ollama tab -->
     <widget class="QWidget" name="tabOllama">
      <attribute name="title"><string>Ollama (local)</string></attribute>
      <layout class="QVBoxLayout">
       <item>
        <widget class="QLabel" name="labelHelpOllama">
         <property name="textFormat"><enum>Qt::RichText</enum></property>
         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string>&lt;b&gt;Ollama — local AI, no account needed&lt;/b&gt;&lt;br/&gt;Install Ollama and pull a model, then connect below.</string></property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout">
         <item>
          <widget class="QPushButton" name="btnOpenBrowserOllama">
           <property name="text"><string>Open ollama.com</string></property>
          </widget>
         </item>
         <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
        </layout>
       </item>
       <item>
        <layout class="QFormLayout">
         <item row="0" column="0">
          <widget class="QLabel"><property name="text"><string>Endpoint:</string></property></widget>
