       </item>
       <item>
        <layout class="QHBoxLayout">
         <item>
          <widget class="QPushButton" name="btnConnectOllama">
           <property name="text"><string>Test Connection</string></property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="labelStatusOllama">
           <property name="text"><string>Not connected</string></property>
          </widget>
         </item>
         <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
        </layout>
       </item>
       <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
      </layout>
     </widget>

    </widget>
   </item>

   <!-- Active provider selector -->
   <item>
    <layout class="QFormLayout">
     <item row="0" column="0">
      <widget class="QLabel"><property name="text"><string>Active provider:</string></property></widget>
     </item>
     <item row="0" column="1">
      <widget class="QComboBox" name="comboActiveProvider">
       <item><property name="text"><string>OpenAI (ChatGPT)</string></property></item>
       <item><property name="text"><string>Anthropic (Claude)</string></property></item>
       <item><property name="text"><string>Ollama (local)</string></property></item>
      </widget>
     </item>
    </layout>
   </item>

   <!-- Buttons -->
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons"><set>QDialogButtonBox::Ok|QDialogButtonBox::Cancel</set></property>
    </widget>
   </item>

  </layout>
 </widget>
